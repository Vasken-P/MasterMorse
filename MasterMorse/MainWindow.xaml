<Window x:Class="MasterMorse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Morse Code Translator"
        Height="720" Width="900" MinHeight="480" MinWidth="360"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="110"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Morse Code Translator" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Translate text into Morse code and Morse code back into text. Results update as you type."
                       TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,20"/>

            <WrapPanel Margin="0,0,0,20">
                <Button Content="1v1 Easy (multiple choice)" Click="DuelEasy_Click" MinWidth="200"/>
                <Button Content="1v1 Hard (typed answer)" Click="DuelHard_Click" MinWidth="200"/>
            </WrapPanel>

            <TextBlock x:Name="InputHeaderText" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <TextBox x:Name="InputTextBox" TextChanged="InputTextBox_TextChanged"/>
            </Border>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="Translate" Click="Translate_Click"/>
                <Button Content="⇅ Swap" Click="Swap_Click"/>
                <Button Content="Clear" Click="Clear_Click"/>
            </WrapPanel>

            <TextBlock x:Name="OutputHeaderText" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <TextBox x:Name="OutputTextBox" IsReadOnly="True"/>
            </Border>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="Copy" Click="Copy_Click"/>
                <Button Content="Play" Click="Play_Click"/>
                <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click"/>
                <Button Content="Stop" Click="Stop_Click"/>
            </WrapPanel>

            <TextBlock x:Name="ValidationText" Foreground="#C62828" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,20"/>
        </StackPanel>
    </ScrollViewer>
</Window>
