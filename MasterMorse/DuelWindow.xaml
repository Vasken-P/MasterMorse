<Window x:Class="MasterMorse.DuelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1v1 Morse Duel"
        Height="780" Width="1100" MinHeight="620" MinWidth="820"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Setup -->
        <ScrollViewer x:Name="SetupPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,40,32,24" MaxWidth="720" HorizontalAlignment="Center">
                <ContentControl Content="{StaticResource MorseLogo}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                <TextBlock x:Name="SetupTitle" Text="1v1 Morse Duel" Style="{StaticResource TitleText}"/>
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,24"
                           Text="Two players share this keyboard. Both get the same five questions, and the highest score wins."/>

                <!-- Shown only for the Easy mode the window was opened with -->
                <Border x:Name="EasyControls" Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Multiple choice: pick the Morse code for the letter"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Background="{StaticResource PrimaryContainerBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <TextBlock Foreground="{StaticResource OnPrimaryContainerBrush}" TextWrapping="Wrap"
                                       Text="Player 1:  W = previous choice,  A = next choice,  D = submit"/>
                        </Border>
                        <Border Background="{StaticResource Player2ContainerBrush}" CornerRadius="10" Padding="14,10">
                            <TextBlock Foreground="{StaticResource Player2Brush}" TextWrapping="Wrap"
                                       Text="Player 2:  Up = previous choice,  Down = next choice,  Enter = submit"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Shown only for the Hard mode the window was opened with -->
                <Border x:Name="HardControls" Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Typed answer: key the abbreviation in Morse"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Border Background="{StaticResource PrimaryContainerBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <TextBlock Foreground="{StaticResource OnPrimaryContainerBrush}" TextWrapping="Wrap"
                                       Text="Player 1:  W = dot,  A = dash,  S = space (tap: new letter, hold: new word),  D = submit"/>
                        </Border>
                        <Border Background="{StaticResource Player2ContainerBrush}" CornerRadius="10" Padding="14,10">
                            <TextBlock Foreground="{StaticResource Player2Brush}" TextWrapping="Wrap"
                                       Text="Player 2:  Up = dot,  Down = dash,  Right = space (tap: new letter, hold: new word),  Enter = submit"/>
                        </Border>
                        <TextBlock Text="The letters are decoded when you submit."
                                   Style="{StaticResource SubtitleText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <WrapPanel>
                    <Button Content="Start match" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
                    <Button Content="Close" Style="{StaticResource TextButton}" Click="Close_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Round -->
        <Grid x:Name="MatchPanel" Margin="24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RoundText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimerText" Grid.Column="1" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,20,0"/>
                <Button Grid.Column="2" Content="Leave" Style="{StaticResource TextButton}" Margin="0"
                        Click="Leave_Click"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16" Padding="24,20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PromptText" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RevealText" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Player 1 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Player 1  (W A S D)" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <TextBlock x:Name="OneScore" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="OneTimer" Style="{StaticResource SubtitleText}" Margin="0,2,0,14"/>
                        <StackPanel x:Name="OneChoices" Margin="0,0,0,12"/>
                        <StackPanel x:Name="OneKeyedArea">
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,8">
                                <TextBlock x:Name="OneKeyed" FontFamily="{StaticResource MonoFont}" FontSize="30"
                                           MinHeight="48" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock x:Name="OneDecoded" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="OneFeedback" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Player 2 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Player2Brush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Player 2  (Arrows, Enter)" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <TextBlock x:Name="TwoScore" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource Player2Brush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TwoTimer" Style="{StaticResource SubtitleText}" Margin="0,2,0,14"/>
                        <StackPanel x:Name="TwoChoices" Margin="0,0,0,12"/>
                        <StackPanel x:Name="TwoKeyedArea">
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,8">
                                <TextBlock x:Name="TwoKeyed" FontFamily="{StaticResource MonoFont}" FontSize="30"
                                           MinHeight="48" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock x:Name="TwoDecoded" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TwoFeedback" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Result -->
        <ScrollViewer x:Name="ResultPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="32,40,32,24" MaxWidth="900" HorizontalAlignment="Center">
                <TextBlock x:Name="WinnerText" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock x:Name="FinalScoreText" FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20"/>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <Border CornerRadius="16" ClipToBounds="True">
                        <DataGrid x:Name="RoundsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserResizeRows="False" Height="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Round" Binding="{Binding Round}"/>
                                <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt}" Width="*"/>
                                <DataGridTextColumn Header="Answer" Binding="{Binding Answer}"/>
                                <DataGridTextColumn Header="Player 1" Binding="{Binding PlayerOne}"/>
                                <DataGridTextColumn Header="Player 2" Binding="{Binding PlayerTwo}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Border>
                <WrapPanel>
                    <Button Content="Play again" Style="{StaticResource PrimaryButton}" Click="PlayAgain_Click"/>
                    <Button Content="Leave" Style="{StaticResource TextButton}" Click="Leave_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="24,0,24,12"
                   Style="{StaticResource SubtitleText}"/>
    </Grid>
</Window>
