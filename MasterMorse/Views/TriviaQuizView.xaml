<Window x:Class="MasterMorse.Views.TriviaQuizView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MorseMaster - Quiz" Height="700" Width="900"
        MinHeight="560" MinWidth="680">
    <Window.Resources>
        <Style x:Key="QuizAnswerStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="AnswerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Ellipse x:Name="SelectionIndicator"
                                         Width="14" Height="14"
                                         HorizontalAlignment="Right"
                                         Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="1.5" />
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AnswerBorder" Property="Background" Value="#F4F7FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AnswerBorder" Property="Background" Value="#EEF5FC" />
                                <Setter TargetName="AnswerBorder" Property="BorderBrush" Value="#315F90" />
                                <Setter TargetName="SelectionIndicator" Property="Fill" Value="#315F90" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AnswerBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="MorseMaster Quiz"
                       FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Choose one answer for each question."
                       Margin="0,4,0,0" Foreground="DimGray"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="QuestionPanel" MaxWidth="720"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                <DockPanel Margin="0,0,0,16">
                    <TextBlock x:Name="ProgressText" DockPanel.Dock="Left"
                               FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="ScoreText" DockPanel.Dock="Right"
                               FontSize="18" FontWeight="SemiBold" />
                </DockPanel>

                <Border Padding="24" BorderBrush="#D0D0D0" BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="QuestionText" FontSize="22"
                                   TextWrapping="Wrap" Margin="0,0,0,16" />
                        <UniformGrid x:Name="AnswersPanel" Columns="2" />
                        <Button x:Name="SubmitAnswerButton" Content="Submit answer"
                                HorizontalAlignment="Left" Padding="16,8"
                                Margin="0,12,0,0" Click="OnSubmitAnswer" />
                        <TextBlock x:Name="AnswerFeedbackText"
                                   Margin="0,12,0,0" FontSize="16"
                                   TextWrapping="Wrap" />
                        <Button x:Name="NextQuestionButton" Content="Next question"
                                HorizontalAlignment="Left" Padding="16,8"
                                Margin="0,16,0,0" Visibility="Collapsed"
                                Click="OnNextQuestion" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Congratulations! You finished all 10 questions."
                           FontSize="26" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="FinalScoreText" Margin="0,18,0,0"
                           FontSize="22" TextAlignment="Center" />
                <TextBlock x:Name="AverageScoreText" Margin="0,8,0,20"
                           FontSize="18" TextAlignment="Center" />
                <Button Content="Return to title" Padding="18,9"
                        HorizontalAlignment="Center" Click="OnReturnToTitle" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
