<Window x:Class="MasterMorse.Views.GuidebookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MasterMorse" Height="700" Width="900"
        MinHeight="560" MinWidth="680">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Morse code guidebook"
                       FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="LessonCountText"
                       Margin="0,4,0,0"
                       Foreground="DimGray" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LessonTitleText"
                           FontSize="22" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="LessonExplanationText"
                           Margin="0,10,0,18"
                           FontSize="16" TextWrapping="Wrap" />

                <TextBlock Text="Examples"
                           FontSize="18" FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="ExamplesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D0D0D0" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Character}"
                                               FontSize="18" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Pattern}"
                                               FontSize="18" FontFamily="Consolas"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Reading}"
                                               FontSize="15" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,12,0,0" Padding="16"
                        Background="#F3F6FA" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Quick practice"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="PracticePromptText"
                                   Margin="0,8,0,10"
                                   FontSize="16" TextWrapping="Wrap" />
                        <DockPanel LastChildFill="False">
                            <TextBox x:Name="PracticeAnswerText"
                                     MinWidth="120" MaxWidth="240"
                                     Padding="6" FontSize="16"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Your answer" />
                            <Button x:Name="SubmitAnswerButton"
                                    Content="Check answer"
                                    Margin="8,0,0,0" Padding="12,6"
                                    Click="OnSubmitAnswer" />
                        </DockPanel>
                        <TextBlock x:Name="PracticeFeedbackText"
                                   Margin="0,8,0,0"
                                   FontSize="15" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="PreviousLessonButton"
                    DockPanel.Dock="Left"
                    Content="Previous lesson"
                    Padding="12,7" Click="OnPreviousLesson" />
            <Button x:Name="NextLessonButton"
                    DockPanel.Dock="Right"
                    Content="Next lesson"
                    Padding="12,7" Click="OnNextLesson" />
        </DockPanel>
    </Grid>
</Window>
