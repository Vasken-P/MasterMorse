<Window x:Class="MasterMorse.Views.TitleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MorseMaster" Height="700" Width="900"
        MinHeight="560" MinWidth="680">
    <Grid Margin="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="MorseMaster" FontSize="36" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Learn Morse code, one signal at a time."
                       FontSize="16" Margin="0,12,0,24"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel HorizontalAlignment="Center">
                <Button Content="Get Started" Padding="24,10"
                        HorizontalAlignment="Center" Click="OnGetStarted" />
                <Button Content="Play Jeopardy Quiz" Padding="24,10" Margin="0,10,0,0"
                        HorizontalAlignment="Center" Click="OnQuizRequested" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
